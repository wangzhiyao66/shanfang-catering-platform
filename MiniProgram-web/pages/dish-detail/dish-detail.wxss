/* pages/dish-detail/dish-detail.wxss */
.detail { padding-bottom: 120rpx; }
.hero { height: 320rpx; background: var(--brand-soft); color: var(--brand); font-size: 120rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.block { background: #fff; padding: 24rpx; margin-bottom: 16rpx; }
.dish-name { font-size: 34rpx; font-weight: 700; }
.from { font-size: 26rpx; }
.spec-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.req { color: var(--brand); font-size: 22rpx; font-weight: 400; }
.opt-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.opt { padding: 12rpx 24rpx; border: 1rpx solid var(--line); border-radius: 40rpx; font-size: 26rpx; }
.opt-price { color: var(--brand); margin-left: 6rpx; }
