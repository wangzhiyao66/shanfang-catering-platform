/* pages/menu/menu.wxss */
.menu { display: flex; height: 100vh; box-sizing: border-box; padding-bottom: 340rpx; }

.side { width: 180rpx; background: #f0f1f3; height: 100%; }
.side-item { padding: 32rpx 16rpx; font-size: 26rpx; color: #333; text-align: center; }
.side-item.active { background: #fff; color: var(--brand); font-weight: 600; border-left: 6rpx solid var(--brand); }

.main { flex: 1; height: 100%; padding: 16rpx; background: #fff; }
.dish { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.dish-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: var(--brand-soft); color: var(--brand); font-size: 48rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; }
.dish-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.dish-name { font-size: 30rpx; font-weight: 600; }
.dish-meta { display: flex; align-items: center; gap: 10rpx; }
.dish-price { font-size: 32rpx; }
.dish-actions { display: flex; justify-content: flex-end; }

/* 底部购物车条 —— 对齐原型 .cartbar（通栏深色 + 左侧“已点 N 件 ¥X” + 右侧品牌红“去结算”） */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  background: #2b2f36;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.12);
  z-index: 100;
}
.cart-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.cart-count {
  font-size: 26rpx;
  color: #fff;
}
.cart-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff9d5c;
}
.cart-amount .price {
  color: #ff9d5c;
  font-size: 34rpx;
  font-weight: 700;
}
.cart-amount .price::before {
  font-size: 22rpx;
  color: #ff9d5c;
  margin-right: 2rpx;
}
.cart-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.bar-btn {
  height: 72rpx !important;
  min-width: 180rpx !important;
  border-radius: 36rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  margin-left: 0 !important;
  background: var(--brand) !important;
  border-color: var(--brand) !important;
  color: #fff !important;
}
