/* pages/member/member.wxss */
.member { padding-bottom: 40rpx; }
.header { background: linear-gradient(135deg, var(--brand), #ff7a5c); color: #fff; padding: 48rpx 32rpx; display: flex; align-items: center; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,.3); display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 700; margin-right: 24rpx; }
.name { font-size: 34rpx; font-weight: 700; margin-bottom: 10rpx; }
.stats { display: flex; background: #fff; margin: -30rpx 24rpx 0; border-radius: 16rpx; padding: 28rpx 0; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06); }
.stat { flex: 1; text-align: center; }
.num { font-size: 34rpx; font-weight: 700; }
.label { font-size: 24rpx; color: var(--sub); margin-top: 6rpx; }
.section-title { padding: 32rpx 24rpx 12rpx; font-size: 28rpx; font-weight: 600; }
.coupon { display: flex; margin: 16rpx 24rpx; background: #fff; border-radius: 12rpx; overflow: hidden; }
.coupon-left { width: 180rpx; background: var(--brand); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.c-amount { font-size: 48rpx; font-weight: 700; }
.c-cond { font-size: 22rpx; opacity: .9; }
.coupon-right { flex: 1; padding: 24rpx; }
.c-name { font-size: 28rpx; font-weight: 600; }
.c-date { font-size: 22rpx; margin-top: 8rpx; }
