/* pages/order/order.wxss */
.order { padding-bottom: 120rpx; }
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin: 16rpx; }
.card-head { display: flex; justify-content: space-between; font-size: 28rpx; margin-bottom: 12rpx; }
.card-head .price { font-size: 30rpx; }
.dish-line { font-size: 26rpx; color: #333; padding: 4rpx 0; }
.card-ops { display: flex; justify-content: flex-end; margin-top: 12rpx; }
