/* pages/home/home.wxss */
.home {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 20rpx;
}

/* 顶部店名 */
.hd {
  background: #e8543f;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  padding: 28rpx 0 24rpx;
}

/* 搜索 */
.search {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 36rpx;
  color: #9aa0a8;
  font-size: 26rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* banner */
.banner {
  margin: 20rpx 24rpx 0;
  background: linear-gradient(135deg, #ff7a59, #e8543f);
  border-radius: 20rpx;
  color: #fff;
  padding: 30rpx 32rpx;
}
.b-title { font-size: 32rpx; font-weight: 700; }
.b-sub { font-size: 24rpx; opacity: 0.92; margin-top: 8rpx; }

/* 快捷入口 */
.quick {
  display: flex;
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
}
.q-item { flex: 1; text-align: center; }
.q-ic { font-size: 48rpx; }
.q-tx { font-size: 24rpx; color: #333; margin-top: 10rpx; }

/* 区块 */
.sec { margin: 24rpx 24rpx 0; }
.sec-hd {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.more { font-size: 24rpx; color: #9aa0a8; font-weight: 400; }

/* 店长推荐卡片 */
.rec { display: flex; gap: 18rpx; }
.rec-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.rec-img { width: 100%; height: 150rpx; background: #f0f0f0; }
.rec-name {
  font-size: 24rpx;
  color: #333;
  padding: 12rpx 14rpx 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rec-price { font-size: 26rpx; color: #e8543f; font-weight: 700; padding: 4rpx 14rpx 14rpx; }

/* 热销榜 */
.hot { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; }
.hot-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.hot-row:last-child { border-bottom: none; }
.hot-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #ffece6;
  color: #e8543f;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 20rpx;
}
.hot-name { flex: 1; font-size: 28rpx; color: #333; }
.hot-price { font-size: 26rpx; color: #e8543f; font-weight: 700; }
